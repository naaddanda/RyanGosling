<Window x:Class="SalonAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SalonAdmin"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="400" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Border Width="380" Height="350"
                Background="White"
                CornerRadius="12">
            <StackPanel Margin="24">
                <TextBlock Text="Вход в систему"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,24"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Логин"
                           Foreground="{StaticResource TextLightBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLogin"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Пароль"
                           Foreground="{StaticResource TextLightBrush}"
                           Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtPassword"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource InputStyle}"/>

                <Button Content="Войти"
                        Style="{StaticResource AccentBtn}"
                        Click="BtnLogin_Click"
                        Margin="0,28,0,12"
                        Height="38"/>

                <Button Content="Отмена"
                        Style="{StaticResource NavBtn}"
                        Click="BtnCancel_Click"
                        Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>