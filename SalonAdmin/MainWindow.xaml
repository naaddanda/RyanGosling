<Window x:Class="SalonAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SalonAdmin" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side nav -->
        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Админ‑панель" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Парикмахерская2" Margin="0,4,0,0" Foreground="{StaticResource TextLightBrush}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Style="{StaticResource NavBtn}" Content="🏠  Дашборд" Tag="Dashboard" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="📅  Записи" Tag="Records" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="👥  Сотрудники" Tag="Employees" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="✂️  Услуги" Tag="Services" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="📦  Склад" Tag="Stocks" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="👤  Клиенты" Tag="Clients" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="🏷️  Акции" Tag="Promotions" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="📜  Журнал" Tag="Journal" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="📊  Отчёты" Tag="Reports" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavBtn}" Content="⚙️  Настройки" Tag="Settings" Click="Nav_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>

