<Page x:Class="SalonAdmin.Pages.StocksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📦 Склад / Расходники" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="Поиск по расходникам..."
                         Foreground="#999999"
                         GotFocus="TxtSearch_GotFocus"
                         LostFocus="TxtSearch_LostFocus"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="2" Content="Открыть партии" Style="{StaticResource AccentBtn}" Click="BtnOpen_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  Background="White"
                  BorderBrush="#EEE"
                  BorderThickness="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Критично}" Value="True">
                            <Setter Property="Background" Value="#FFF1F1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Название}" Width="2*"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Ед}" Width="120"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Остаток}" Width="100"/>
                <DataGridTextColumn Header="Мин. срок" Binding="{Binding МинСрок, StringFormat={}{0:dd.MM.yyyy}}" Width="140"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

