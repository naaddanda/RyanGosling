<Page x:Class="SalonAdmin.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="🏠 Дашборд" FontSize="22" FontWeight="SemiBold" />

            <UniformGrid Columns="2" Rows="2" Margin="0,16,0,0">
                <!-- Записей на сегодня -->
                <Border Margin="8" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Записей на сегодня" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="TxtTodayCount" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Свободные окна -->
                <Border Margin="8" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Свободные окна мастеров" Foreground="{StaticResource TextLightBrush}" />
                        <ItemsControl x:Name="LstFreeMasters" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Расходники -->
                <Border Margin="8" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Расходники к концу" Foreground="{StaticResource TextLightBrush}" />
                        <ItemsControl x:Name="LstLowStock" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#C62828" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Выручка -->
                <Border Margin="8" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Выручка за 7 дней" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="TxtWeekRevenue" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>