<Page x:Class="SalonAdmin.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFFFF">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Утренняя сводка" FontSize="22" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,0,0,20">
            <Border Background="#FFFFFF" BorderBrush="#DE9EB7" BorderThickness="1" 
                    CornerRadius="6" Margin="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="Записей на сегодня" Foreground="#666666"/>
                    <TextBlock x:Name="tbToday" Text="0" FontSize="34" 
                               FontWeight="Bold" Foreground="#DE9EB7" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DE9EB7" BorderThickness="1" 
                    CornerRadius="6" Margin="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="Свободные окна мастеров" Foreground="#666666"/>
                    <TextBlock x:Name="tbSlots" Text="—" FontSize="14" 
                               Foreground="#333333" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#FF5C5C" BorderThickness="1" 
                    CornerRadius="6" Margin="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="⚠️ Расходники к концу" Foreground="#FF5C5C" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbStock" Text="—" FontSize="14" 
                               Foreground="#333333" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DE9EB7" BorderThickness="1" 
                    CornerRadius="6" Margin="4" Padding="20">
                <StackPanel>
                    <TextBlock Text="Выручка за 7 дней" Foreground="#666666"/>
                    <TextBlock x:Name="tbRev" Text="0 ₽" FontSize="34" 
                               FontWeight="Bold" Foreground="#DE9EB7" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Page>