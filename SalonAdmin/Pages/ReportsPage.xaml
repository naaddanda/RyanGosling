<Page x:Class="SalonAdmin.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 Отчёты" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="С:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                <DatePicker x:Name="DpFrom" Grid.Column="2" SelectedDateChanged="Date_Changed"/>
                <TextBlock Grid.Column="4" Text="По:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                <DatePicker x:Name="DpTo" Grid.Column="6" SelectedDateChanged="Date_Changed"/>

                <Button Grid.Column="8" Content="Пересчитать" Style="{StaticResource AccentBtn}" Click="BtnCalc_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16" Grid.ColumnSpan="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Выручка за период: " Foreground="{StaticResource TextLightBrush}" FontSize="14"/>
                    <TextBlock x:Name="TxtRevenue" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Топ услуг" Margin="0,14,0,6" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Топ мастеров" Margin="0,14,0,6" FontWeight="SemiBold"/>

            <ListBox x:Name="LstTopServices" Grid.Row="3" BorderBrush="#EEE" Background="White" />
            <ListBox x:Name="LstTopMasters" Grid.Row="3" Grid.Column="2" BorderBrush="#EEE" Background="White" />
        </Grid>
    </Grid>
</Page>

