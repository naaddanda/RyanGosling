<Page x:Class="SalonAdmin.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFFFF">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Сотрудники" FontSize="22" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox x:Name="txtSearch" Width="240" Height="32" Padding="10,5" 
                     Text="Поиск по ФИО..." Foreground="#999"
                     GotFocus="Txt_GotFocus" LostFocus="Txt_LostFocus"/>
            <Button Content="+ Добавить" Width="110" Height="32" Margin="10,0,0,0"
                    Style="{StaticResource AccentBtn}"/>
        </StackPanel>

        <DataGrid x:Name="dg" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#FFFFFF" AlternatingRowBackground="#F9F9F9"
                  BorderBrush="#EEE" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding Стаж}" Width="*"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Рейтинг}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Статус}" Width="*"/>
                <DataGridTemplateColumn Header="Действия" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,0">
                                <Button Content="✏️" Margin="0,0,4,0" Tag="{Binding Id}" Click="Edit_Click"/>
                                <Button Content="🗓️" Tag="{Binding Id}" Click="Vac_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>