<Page x:Class="SalonAdmin.Pages.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="📦 Партии расходника: " FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtTitle" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Показать:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                <ComboBox x:Name="CmbMode" Grid.Column="2" Width="220" Height="34" VerticalContentAlignment="Center"
                          SelectionChanged="CmbMode_SelectionChanged"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  Background="White"
                  BorderBrush="#EEE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата закупки" Binding="{Binding Дата_закупки, StringFormat={}{0:dd.MM.yyyy}}" Width="130"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="90"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Стоимость, StringFormat={}{0:N0} ₽}" Width="130"/>
                <DataGridTextColumn Header="Срок годности" Binding="{Binding Срок_годности_партии, StringFormat={}{0:dd.MM.yyyy}}" Width="140"/>
                <DataGridTextColumn Header="Условия хранения" Binding="{Binding Условия_хранения}" Width="2*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

