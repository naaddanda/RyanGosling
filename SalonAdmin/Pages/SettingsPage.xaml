<Page x:Class="SalonAdmin.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="⚙️ Настройки" FontSize="22" FontWeight="SemiBold"/>

            <!-- Строка подключения -->
            <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,12">
                <StackPanel>
                    <TextBlock Text="Строка подключения (read-only)" Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox x:Name="TxtConn" Margin="0,8,0,0" TextWrapping="Wrap" IsReadOnly="True"
                             BorderBrush="#EEE" Background="#FAFAFA" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Проверить подключение" Style="{StaticResource AccentBtn}" Click="BtnTest_Click"/>
                        <TextBlock x:Name="TxtStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ✅ КАЛЬКУЛЯТОР (по приколу) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#DE9EB7" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🧮 Калькулятор" FontSize="16" FontWeight="SemiBold" Foreground="#DE9EB7"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Первое число -->
                        <TextBox x:Name="TxtNum1" Grid.Column="0" Height="34" Margin="0,0,8,0"
                                 HorizontalContentAlignment="Center" PreviewTextInput="TxtNum_PreviewTextInput"/>

                        <!-- Операция -->
                        <ComboBox x:Name="CbOp" Grid.Column="2" Width="60" Height="34" Margin="4,0,4,0"
                                  HorizontalContentAlignment="Center">
                            <ComboBoxItem Content="+" IsSelected="True"/>
                            <ComboBoxItem Content="-"/>
                            <ComboBoxItem Content="*"/>
                            <ComboBoxItem Content="/"/>
                        </ComboBox>

                        <!-- Второе число -->
                        <TextBox x:Name="TxtNum2" Grid.Column="4" Height="34" Margin="8,0,0,0"
                                 HorizontalContentAlignment="Center" PreviewTextInput="TxtNum_PreviewTextInput"/>
                    </Grid>

                    <!-- Кнопка и результат -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Button Content="= Посчитать" Width="120" Height="34" 
                                Style="{StaticResource AccentBtn}" Click="BtnCalc_Click"/>
                        <TextBlock x:Name="TxtResult" Margin="16,0,0,0" VerticalAlignment="Center" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#DE9EB7"/>
                    </StackPanel>

                    <TextBlock Text="Удобный калькулятор прямо под рукой 😍" 
                               Foreground="#999" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>

            <!-- Примечание -->
            <Border Grid.Row="3" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="Примечание" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextLightBrush}">
                        Приложение работает с существующей БД и не меняет схему. Если какие‑то функции требуют новых полей (например, отпуск/статус сотрудника),
                        нужно добавлять таблицу/колонки отдельно.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

