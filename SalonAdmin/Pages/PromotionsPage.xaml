<Page x:Class="SalonAdmin.Pages.PromotionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏷️ Акции (сезонные предложения)" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="Поиск по названию/услуге..."
                         Foreground="#999999"
                         GotFocus="TxtSearch_GotFocus"
                         LostFocus="TxtSearch_LostFocus"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="2" Content="Сохранить изменения" Style="{StaticResource AccentBtn}" Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  Background="White"
                  BorderBrush="#EEE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Название, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>

                <DataGridTemplateColumn Header="Услуга" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Services}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      SelectedValue="{Binding Id_услуга, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="30"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Сезон" Binding="{Binding Сезон_год, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding Скидка_процент, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Описание, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

