<Page x:Class="SalonAdmin.Pages.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📜 Журнал действий менеджера" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="С:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                <DatePicker x:Name="DpFrom" Grid.Column="2" SelectedDateChanged="Date_Changed"/>

                <TextBlock Grid.Column="4" Text="По:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}"/>
                <DatePicker x:Name="DpTo" Grid.Column="6" SelectedDateChanged="Date_Changed"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  Background="White"
                  BorderBrush="#EEE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата/время" Binding="{Binding ДатаВремя, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="180"/>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Менеджер}" Width="140"/>
                <DataGridTextColumn Header="Таблица" Binding="{Binding Таблица}" Width="160"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding Действие}" Width="3*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

