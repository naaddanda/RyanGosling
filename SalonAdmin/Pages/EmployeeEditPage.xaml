<Page x:Class="SalonAdmin.Pages.EmployeeEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SalonAdmin.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock x:Name="TxtTitle" Text="✏️ Редактирование сотрудника" 
                       FontSize="22" FontWeight="SemiBold"/>

            <!-- Форма -->
            <Border Grid.Row="1" Background="White" BorderBrush="#EEE" 
                    BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,16,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Фамилия -->
                        <RowDefinition Height="12"/>
                        <!-- 1: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Имя -->
                        <RowDefinition Height="12"/>
                        <!-- 3: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Отчество -->
                        <RowDefinition Height="12"/>
                        <!-- 5: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: Телефон -->
                        <RowDefinition Height="12"/>
                        <!-- 7: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 8: Стаж -->
                        <RowDefinition Height="12"/>
                        <!-- 9: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 10: Рейтинг -->
                        <RowDefinition Height="12"/>
                        <!-- 11: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 12: Квалификация -->
                        <RowDefinition Height="12"/>
                        <!-- 13: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 14: Статус -->
                        <RowDefinition Height="12"/>
                        <!-- 15: отступ -->
                        <RowDefinition Height="Auto"/>
                        <!-- 16: Фото -->
                    </Grid.RowDefinitions>

                    <!-- ФИО -->
                    <TextBlock Grid.Row="0" Text="Фамилия*" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFam" Height="34" Margin="0,0,0,2"/>

                    <TextBlock Grid.Row="2" Text="Имя*" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtName" Height="34" Margin="0,0,0,2"/>

                    <TextBlock Grid.Row="4" Text="Отчество" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtOt" Height="34" Margin="0,0,0,2"/>

                    <!-- Контакты -->
                    <TextBlock Grid.Row="6" Text="Телефон*" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtTel" Height="34" Margin="0,0,0,2"
                             PreviewTextInput="TxtTel_PreviewTextInput"/>

                    <!-- Параметры -->
                    <TextBlock Grid.Row="8" Text="Стаж (лет)*" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtStazh" Height="34" Margin="0,0,0,2"
                             PreviewTextInput="TxtInt_PreviewTextInput"/>

                    <TextBlock Grid.Row="10" Text="Рейтинг (0–5)" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtRating" Height="34" Margin="0,0,0,2"
                             PreviewTextInput="TxtDecimal_PreviewTextInput"/>

                    <!-- Квалификация -->
                    <TextBlock Grid.Row="12" Text="Квалификация" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <ComboBox Grid.Row="12" Grid.Column="1" x:Name="CbQual" Height="34" Margin="0,0,0,2"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <!-- ✅ Статус -->
                    <TextBlock Grid.Row="14" Text="Статус" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <ComboBox Grid.Row="14" Grid.Column="1" x:Name="CbStatus" Height="34" Margin="0,0,0,2"
                              DisplayMemberPath="Value" SelectedValuePath="Key"/>

                    <!-- Фото -->
                    <TextBlock Grid.Row="16" Text="Фото (имя файла)" VerticalAlignment="Center" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <Grid Grid.Row="16" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPhoto" Height="34" Margin="0,0,8,2" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Выбрать" Width="80" Height="34" 
                                Style="{StaticResource AccentBtn}" Click="BtnChoosePhoto_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Height="36" Margin="0,0,12,0"
                        Click="BtnCancel_Click" Style="{StaticResource NavBtn}"/>
                <Button Content="💾 Сохранить" Width="120" Height="36"
                        Click="BtnSave_Click" Style="{StaticResource AccentBtn}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>