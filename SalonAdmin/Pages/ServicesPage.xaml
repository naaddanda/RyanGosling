<Page x:Class="SalonAdmin.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="✂️ Услуги" FontSize="22" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbCategory" Height="34" VerticalContentAlignment="Center"
                          SelectionChanged="Filter_Changed"/>

                <TextBox x:Name="TxtSearch"
                         Grid.Column="2"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="Поиск по названию..."
                         Foreground="#999999"
                         GotFocus="TxtSearch_GotFocus"
                         LostFocus="TxtSearch_LostFocus"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="4" Content="Сохранить изменения" Style="{StaticResource AccentBtn}" Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Dg"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  Background="White"
                  BorderBrush="#EEE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Название, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Длительность (мин)" Binding="{Binding Длительность, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Цена, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0} ₽}" Width="140"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Категория}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

